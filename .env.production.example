# Template for the .env on the AWS server.
#   cp .env.production.example .env   then fill in every CHANGE_ME.
# Never commit the real .env.

COMPOSE_FILE=docker-compose.prod.yml

APP_NAME=FreshCart
APP_ENV=production
APP_DEBUG=false
# Copy APP_KEY from your local .env so existing encrypted data keeps working.
APP_KEY=CHANGE_ME
# http://YOUR_ELASTIC_IP for now; https://yourdomain.com once DNS points here.
APP_URL=CHANGE_ME
APP_ADMIN_URL=admin
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_CURRENCY=PHP

# Leave as ":80" to serve plain HTTP on the server IP.
# Set to your domain (no http://), e.g. shop.example.com, to turn on HTTPS.
SITE_ADDRESS=:80

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_DATABASE=bagisto
# Must NOT be "root".
DB_USERNAME=bagisto
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME
DB_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=120
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file
# The image has no phpredis extension, so use the predis package.
REDIS_CLIENT=predis
RESPONSE_CACHE_ENABLED=true

# Same as local: SMTP details are set in Admin > Configure > Emails.
MAIL_MAILER=bagisto-dynamic-smtp
MAIL_FROM_ADDRESS=CHANGE_ME
MAIL_FROM_NAME="${APP_NAME}"
